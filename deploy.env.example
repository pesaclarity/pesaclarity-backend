# Names for tool/deploy_cloud_run.sh. Copy to deploy.env (git-ignored) and
# fill in. Same names as the repository variables in README,
# "Deploying to Cloud Run". The server's settings and secrets are not here:
# they live on the Cloud Run service (README, "Settings on Cloud Run").
GCP_PROJECT_ID=
GCP_REGION=
# <region>-docker.pkg.dev/<project>/<artifact registry repo>/<image>, no tag
GCP_IMAGE=
GCP_RUNTIME_SERVICE_ACCOUNT=
CLOUD_RUN_SERVICE=
CLOUD_RUN_MIGRATE_JOB=
CLOUD_RUN_PURGE_JOB=
# Quote values that hold several flags.
CLOUD_RUN_SERVICE_FLAGS=""
CLOUD_RUN_JOB_FLAGS=""
# Optional: a Secret Manager secret to hold the API address for the app build.
APP_API_URL_SECRET=

# Emailed copies of the privacy policy: the SHA-256 of each approved policy file
# (sha256sum assets/policy/privacy_policy.md in pesaclarity-app), as a JSON list.
# Empty turns the feature off.
NGOME_PRIVACY_POLICY_SHA256=[]
