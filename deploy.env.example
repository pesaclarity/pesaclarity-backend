# Settings for tool/deploy_cloud_run.sh. Copy to deploy.env (git-ignored) and
# fill in. Same names as the repository variables in README,
# "Deploying to Cloud Run". Secrets stay in Secret Manager.
GCP_PROJECT_ID=
GCP_REGION=
# <region>-docker.pkg.dev/<project>/<artifact registry repo>/<image>, no tag
GCP_IMAGE=
GCP_RUNTIME_SERVICE_ACCOUNT=
CLOUD_RUN_SERVICE=
CLOUD_RUN_MIGRATE_JOB=
CLOUD_RUN_PURGE_JOB=
# Quote values that hold several flags.
CLOUD_RUN_SERVICE_FLAGS=""
CLOUD_RUN_JOB_FLAGS=""
# ENV=secret:version pairs, comma-separated.
CLOUD_RUN_SECRETS=
# A YAML file with every non-secret setting (see README). Keep it out of git.
CLOUD_RUN_ENV_YAML_FILE=cloud-run.env.yaml
# Optional: a Secret Manager secret to hold the API address for the app build.
APP_API_URL_SECRET=
