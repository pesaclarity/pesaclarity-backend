# Copy to .env and fill in. Never commit .env.

# The public name Caddy serves (and gets a certificate for), e.g. sync.example.org
SYNC_DOMAIN=

# Google Cloud Storage (preferred, decision 0033):
#   CELLD_BUCKET=gs://NAME
#   GCS_CREDENTIALS_FILE=/path/on/host/service-account.json
#   GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
# On a GCE/Cloud Run host with an attached service account, leave both file
# settings empty: Application Default Credentials are used.
CELLD_BUCKET=
GCS_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=

# Or Cloudflare R2 (fallback): CELLD_BUCKET=s3://NAME plus
#   S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
#   AWS_REGION=auto
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
