# Copy to .env for local development. Every value here is a placeholder.

NGOME_ENVIRONMENT=development
NGOME_LOG_LEVEL=INFO
NGOME_LOG_JSON=false

NGOME_DATABASE_URL=postgresql+asyncpg://ngome:ngome@localhost:5432/ngome

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NGOME_JWT_SECRET=replace-me-with-at-least-32-random-characters
# Keyed hash for sign-in contacts. Changing it later orphans every account.
NGOME_CONTACT_PEPPER=replace-me-with-at-least-32-random-characters

NGOME_ACCESS_TOKEN_TTL_SECONDS=600
NGOME_REFRESH_TOKEN_TTL_DAYS=30

# "console" prints codes to stdout and is refused in production.
NGOME_SMS_PROVIDER=console

# Play Store build only. The F-Droid build signs in by phone.
NGOME_GOOGLE_SIGN_IN_ENABLED=false
NGOME_GOOGLE_CLIENT_IDS=[]

NGOME_VAULT_MAX_BACKUP_BYTES=67108864
NGOME_VAULT_KEEP_BACKUPS=10

# Where backup ciphertext lives: "postgres" (development and tests) or "s3" (AWS S3,
# Cloudflare R2, MinIO). Metadata stays in Postgres either way.
NGOME_VAULT_BLOB_STORE=postgres
# For the MinIO in docker-compose. For AWS leave the endpoint unset; for R2 use
# https://<account-id>.r2.cloudflarestorage.com with region "auto".
# NGOME_VAULT_BLOB_STORE=s3
NGOME_VAULT_S3_BUCKET=ngome-backups
NGOME_VAULT_S3_ENDPOINT_URL=http://localhost:9000
NGOME_VAULT_S3_REGION=us-east-1
NGOME_VAULT_S3_ADDRESSING_STYLE=path
# Leave both unset to use the standard AWS credential chain (for example an instance role).
# For the docker-compose MinIO, use its MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
NGOME_VAULT_S3_ACCESS_KEY_ID=replace-me
NGOME_VAULT_S3_SECRET_ACCESS_KEY=replace-me

# Federated learning (ngome.fl). Privacy values are placeholders, not a published budget.
NGOME_FL_NUM_ROUNDS=3
NGOME_FL_MIN_COHORT_SIZE=100
NGOME_FL_CLIPPING_NORM=1.0
NGOME_FL_NOISE_MULTIPLIER=1.0
NGOME_FL_SECAGG_NUM_SHARES=20
NGOME_FL_SECAGG_RECONSTRUCTION_THRESHOLD=14
