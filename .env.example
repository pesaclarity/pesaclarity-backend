# Copy to .env for local development. Every value here is a placeholder.

NGOME_ENVIRONMENT=development
NGOME_LOG_LEVEL=INFO
NGOME_LOG_JSON=false

NGOME_DATABASE_URL=postgresql+asyncpg://ngome:ngome@localhost:5432/ngome

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NGOME_JWT_SECRET=replace-me-with-at-least-32-random-characters
# Keyed hash for sign-in contacts. Changing it later orphans every account.
NGOME_CONTACT_PEPPER=replace-me-with-at-least-32-random-characters

NGOME_ACCESS_TOKEN_TTL_SECONDS=600
NGOME_REFRESH_TOKEN_TTL_DAYS=30

# Sign-in codes go by email. "console" prints them to stdout and is refused in
# production; "smtp" sends them through any SMTP relay over STARTTLS.
NGOME_EMAIL_PROVIDER=console
# Sign-in email wording; the API will not start without it. Placeholders: {code}, {minutes}.
NGOME_EMAIL_CODE_SUBJECT="Your Pesa Clarity code: {code}"
NGOME_EMAIL_CODE_BODY="Your Pesa Clarity sign-in code is {code}.\n\nIt works for {minutes} minutes. Keep it to yourself: Pesa Clarity will never ask you for it.\n\nIf you did not ask for a code, you can ignore this email.\n"
# For smtp, every value below is required (Brevo shows them under SMTP & API).
# NGOME_EMAIL_PROVIDER=smtp
# NGOME_EMAIL_FROM="Pesa Clarity <codes@example.org>"
# NGOME_SMTP_HOST=replace-me
# NGOME_SMTP_PORT=replace-me
# NGOME_SMTP_USERNAME=replace-me
# NGOME_SMTP_PASSWORD=replace-me
# NGOME_SMTP_TIMEOUT_SECONDS=replace-me

# Play Store build only. The F-Droid build signs in by email.
NGOME_GOOGLE_SIGN_IN_ENABLED=false
# OAuth client ids accepted as the token audience, e.g. ["1234-abc.apps.googleusercontent.com"]
NGOME_GOOGLE_CLIENT_IDS=[]
NGOME_GOOGLE_TOKEN_LEEWAY_SECONDS=60

# Play Integrity on vault uploads (Play Store build). Off for local development. When on,
# every value below is required; see README, "Play Integrity".
NGOME_PLAY_INTEGRITY_ENABLED=false
# NGOME_PLAY_INTEGRITY_PACKAGE_NAME=replace-me
# NGOME_PLAY_INTEGRITY_DEVICE_VERDICT=replace-me
# NGOME_PLAY_INTEGRITY_MAX_TOKEN_AGE_SECONDS=replace-me
# Uploads without a token (F-Droid builds): allow or reject.
# NGOME_VAULT_UNATTESTED_UPLOADS=replace-me

# Retention, applied by the daily ngome-purge job. Must match the privacy policy.
# Provisional defaults: the final periods still need a decision.
NGOME_RETENTION_OTP_CHALLENGE_HOURS=24
NGOME_RETENTION_AUTH_EVENT_DAYS=90

NGOME_VAULT_MAX_BACKUP_BYTES=67108864
NGOME_VAULT_KEEP_BACKUPS=10
# Per-account quota across the backups an account keeps (256 MiB).
NGOME_VAULT_MAX_ACCOUNT_BYTES=268435456

# Where backup ciphertext lives: "postgres" (development and tests), "filesystem" (files
# under NGOME_VAULT_FS_ROOT) or "s3" (AWS S3, Cloudflare R2, MinIO). Metadata stays in
# Postgres either way.
NGOME_VAULT_BLOB_STORE=postgres
# NGOME_VAULT_BLOB_STORE=filesystem
# NGOME_VAULT_FS_ROOT=./var/blobs
# For the MinIO in docker-compose. For AWS leave the endpoint unset; for R2 use
# https://<account-id>.r2.cloudflarestorage.com with region "auto".
# NGOME_VAULT_BLOB_STORE=s3
NGOME_VAULT_S3_BUCKET=ngome-backups
NGOME_VAULT_S3_ENDPOINT_URL=http://localhost:9000
NGOME_VAULT_S3_REGION=us-east-1
NGOME_VAULT_S3_ADDRESSING_STYLE=path
# Leave both unset to use the standard AWS credential chain (for example an instance role).
# For the docker-compose MinIO, use its MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
NGOME_VAULT_S3_ACCESS_KEY_ID=replace-me
NGOME_VAULT_S3_SECRET_ACCESS_KEY=replace-me

# Federated learning (ngome.fl). Privacy values are placeholders, not a published budget.
NGOME_FL_NUM_ROUNDS=3
NGOME_FL_MIN_COHORT_SIZE=100
NGOME_FL_CLIPPING_NORM=1.0
NGOME_FL_NOISE_MULTIPLIER=1.0
NGOME_FL_SECAGG_NUM_SHARES=20
NGOME_FL_SECAGG_RECONSTRUCTION_THRESHOLD=14
